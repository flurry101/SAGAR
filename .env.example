# ==============================================================================
# SAGAR.ai / ORCA: Local Development Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="SAGAR API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# API Keys & Third-Party Services
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for AI Planner & Risk Synthesis)
GOOGLE_API_KEY=your_google_api_key

# WorldTides API Key (Required for tidal data)
WORLDTIDES_API_KEY=your_worldtides_api_key

# Bhashini Translation API (Optional, for localized alerts)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://meity-auth.udyat.ai/ulca/apis/v0/model/getModelsPipeline

# ------------------------------------------------------------------------------
# Voice Assistant (Vexyl & Sarvam)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key
VEXYL_URL=http://localhost:8081
CUSTOM_LLM_URL=http://host.docker.internal:8000/api/v1/voice/webhook
CUSTOM_LLM_TIMEOUT=30000
LLM_PROVIDER=custom
REALTIME_PROVIDER=sarvam
WEBSOCKET_AUDIO_PORT=8082
WEBSOCKET_AUDIO_HOST=0.0.0.0
WEBSOCKET_AUDIO_ENABLED=true

# ------------------------------------------------------------------------------
# Database & Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase Credentials
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database URL for PostgreSQL (Takes precedence if provided)
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# Local PostgreSQL Configuration (Fallback / Docker Local Dev)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sagar_db

# ------------------------------------------------------------------------------
# Feature Flags & Demo Modes
# ------------------------------------------------------------------------------
DEMO_HAB_MOCK=false
PF_DEMO_MODE=false