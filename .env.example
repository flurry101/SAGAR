# ==============================================================================
# SAGAR.ai: Local Development Environment Variables
# ==============================================================================
# Application Settings
APP_NAME="SAGAR API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
# Local PostgreSQL Configuration (for Docker Compose & Local Dev)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sagar_db
# Supabase Credentials
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# (Optional) Explicit Database URL override:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sagar_db