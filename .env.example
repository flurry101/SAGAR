# ================================================================================
# SAGAR.ai / ORCA: Root Environment Variables
# Use this as the local development template and as the base for Render production envs.
# ================================================================================

APP_NAME="SAGAR API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
DOMAIN=localhost
PROJECT_NAME=sagar
STACK_NAME=sagar

# ----------------------------------------------------------------------------
# Frontend runtime
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=true
VITE_PWD_SIGNUP_ENABLED=true
VITE_GA_TRACKING_ID=

# ----------------------------------------------------------------------------
# Backend runtime
# ----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:5173","https://localhost","https://localhost:5173"]
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Supabase configuration
# ----------------------------------------------------------------------------
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ----------------------------------------------------------------------------
# PostgreSQL configuration
# ----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sagar_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sagar_db

# ------------------------------------------------------------------------------
# Voice Assistant (Vexyl & Sarvam)
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key
VEXYL_URL=http://localhost:8081
CUSTOM_LLM_URL=http://host.docker.internal:8000/api/v1/voice/webhook
CUSTOM_LLM_TIMEOUT=30000
LLM_PROVIDER=custom
REALTIME_PROVIDER=sarvam
WEBSOCKET_AUDIO_PORT=8082
WEBSOCKET_AUDIO_HOST=0.0.0.0
WEBSOCKET_AUDIO_ENABLED=true

# ----------------------------------------------------------------------------
# AI and external APIs
# ----------------------------------------------------------------------------
# Google Gemini API Key (Required for AI Planner & Risk Synthesis)
GOOGLE_API_KEY=your_google_api_key
# WorldTides API Key (Required for tidal data)
WORLDTIDES_API_KEY=your_worldtides_api_key
# Bhashini Translation API (Optional, for localized alerts)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://meity-auth.udyat.ai/ulca/apis/v0/model/getModelsPipeline
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSO_CALLBACK_HOSTNAME=http://localhost:8000
SSO_LOGIN_CALLBACK_URL=http://localhost:5173/sso-login-callback

# ----------------------------------------------------------------------------
# Feature flags and demos
# ----------------------------------------------------------------------------
DEMO_HAB_MOCK=false
PF_DEMO_MODE=false

# ----------------------------------------------------------------------------
# Render / container deployment hints
# ----------------------------------------------------------------------------
# For production, set DATABASE_URL from Render Postgres and set SECRET_KEY/JWT_SECRET
# via the Render dashboard or GitHub repository secrets.
# For frontend in Render use VITE_API_BASE_URL=https://<your-render-backend>.onrender.com/api/v1