APP_NAME=SAGAR API
APP_VERSION=0.1.0
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=change-me-in-development
JWT_SECRET=change-me-in-development

# CORS / frontend URL
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:5173","https://localhost","https://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Supabase Credentials
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# PostgreSQL Database Connection
# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sagar_db

# Or Remote PostgreSQL Connection (Render / Supabase / managed DB):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Fallback local Postgres values if DATABASE_URL is not set
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=sagar_db

# Google Gemini / embeddings (required for LLM and RAG features)
GOOGLE_API_KEY=

# Google OAuth (required for "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SSO_CALLBACK_HOSTNAME=http://localhost:8000
SSO_LOGIN_CALLBACK_URL=http://localhost:5173/sso-login-callback

# Bhashini translation (optional; required only for live translation)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://meity-auth.udyat.ai/ulca/apis/v0/model/getModelsPipeline

# WorldTides (optional; enables Tier 1 tide queries)
WORLDTIDES_API_KEY=

# AISstream.io (optional; enables Tier 1 real-time vessel traffic)
AISSTREAM_API_KEY=

# Demo and test switches
DEMO_HAB_MOCK=false
PF_DEMO_MODE=false

# No credentials are required for these configured public live sources:
# Open-Meteo Marine/Weather API
# NOAA CoastWatch ERDDAP (PFZ and chlorophyll)
# GDACS (hazards)
# OpenZenith GEBCO elevation API (bathymetry)

