APP_NAME=SAGAR API
APP_VERSION=0.1.0
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Supabase Credentials
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Database Connection
# Local Docker Postgres (docker run -d --name sagar_postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgrespassword -e POSTGRES_DB=sagar_db postgres:16-alpine)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sagar_db

# Or Remote Supabase PostgreSQL Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini / embeddings (required for LLM and RAG features)
GOOGLE_API_KEY=

# Bhashini translation (optional; required only for live translation)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://meity-auth.udyat.ai/ulca/apis/v0/model/getModelsPipeline

# WorldTides (optional; enables Tier 1 tide queries)
# Register at https://www.worldtides.info/
WORLDTIDES_API_KEY=

# AISstream.io (optional; enables Tier 1 real-time vessel traffic)
AISSTREAM_API_KEY=

# Demo and test switches
DEMO_HAB_MOCK=false
PF_DEMO_MODE=false

# No credentials are required for these configured public live sources:
# Open-Meteo Marine/Weather API
# NOAA CoastWatch ERDDAP (PFZ and chlorophyll)
# GDACS (hazards)
# OpenZenith GEBCO elevation API (bathymetry)

