# Public API Endpoint for ORCA FastAPI backend (M1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Use Mock Adapter for offline/testing/demo scenarios (default: true)
VITE_USE_MOCK_API=false

# Optional Map Tile Provider URL
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Supabase URL & Public Anon Key for Frontend Auth
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VEXYL_WS_URL=ws://localhost:8082
