# Public API Endpoint for SAGAR FastAPI backend (replace with render url: https://<your-render-backend>.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Use Mock Adapter for offline/testing/demo scenarios (default: true)
VITE_USE_MOCK_API=false

# Optional frontend flags and analytics
VITE_PWD_SIGNUP_ENABLED=true
VITE_GA_TRACKING_ID=

# Optional Map Tile Provider URL
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Supabase URL & Public Anon Key for Frontend Auth
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VEXYL_WS_URL=ws://localhost:8082

# Production Render note:
# For Render deployment, set VITE_API_BASE_URL to https://<your-render-backend>.onrender.com/api/v1
# and set VITE_USE_MOCK_API=false
