{
  "name": "orca-marine-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "extract": "lingui extract --clean",
    "compile": "lingui compile",
    "extract:clean": "lingui extract --clean",
    "i18n:sync": "npm run extract && python3 translate_po.py && npm run compile"
  },
  "dependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/core": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@supabase/supabase-js": "^2.45.3",
    "@tanstack/react-query": "^5.56.2",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.11",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.439.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
